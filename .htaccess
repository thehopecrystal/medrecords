<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Exclude phpMyAdmin, webmail and other server tools from Laravel routing.
    RewriteRule ^phpmyadmin(/.*)?$ - [L]
    RewriteRule ^webmail(/.*)?$ - [L]

    # If the path already begins with public/, stop to prevent infinite rewrite loop.
    RewriteRule ^public/ - [L]

    # Forward everything else into public/ so /public never appears in the URL.
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
